"use client";

// The full-screen vertical Shorts player (SHORTS_TODO 21-26).
//  - One card per short, scroll-snap: a swipe (phone) or the wheel / arrow keys (desktop) moves to the next or earlier short.
//  - Only the card that is on screen plays (IntersectionObserver); every other video is paused. Only the active card and its two
//    neighbours get a <video> element (the rest show the thumbnail), so a long list does not eat memory or data.
//  - Starts muted (browsers refuse sound before a tap); once the person turns the sound on it stays on for the next shorts.
//  - Keyboard: ArrowDown / ArrowUp = next / previous, Space = play / pause, M = mute. Left / Right = -/+ 10 s.
//  - Like / Comment / Save buttons are shown but disabled until SHORTS_TODO step 5. Share (copy link) already works.
//  - Desktop: a phone-shaped frame in the middle; phone: the whole screen.
import Link from "next/link";
import { useCallback, useEffect, useRef, useState } from "react";
import {
  SHORT_COVER_MAX_RATIO, SHORT_COVER_MIN_RATIO, SHORT_PRELOAD_AHEAD, SHORT_SKIP_SECONDS,
} from "@/config/short-feed-config";
import type { ShortFeedText } from "@/config/short-feed-text";
import type { ShortCardData } from "@/lib/short-card";
import { fitMode, formatClock, progressPermille, seekTarget, shouldLoadMore, stepIndex } from "@/lib/short-feed-rules";

type Props = {
  initialItems: ShortCardData[];
  initialNext: string | null;
  text: ShortFeedText;
  uploadHref: string;
  homeHref: string;
};

function fill(text: string, values: Record<string, string>): string {
  return text.replace(/\{(\w+)\}/g, (whole, key: string) => (key in values ? values[key] : whole));
}

const icon = {
  heart: "M12 21s-7-4.6-9.3-9A5.4 5.4 0 0 1 12 6.2 5.4 5.4 0 0 1 21.3 12C19 16.4 12 21 12 21z",
  comment: "M4 5h16v11H9l-5 4z",
  save: "M6 3h12v18l-6-4-6 4z",
  share: "M4 12v7h16v-7M12 3v12M7 8l5-5 5 5",
  up: "M6 15l6-6 6 6",
  down: "M6 9l6 6 6-6",
  volume: "M4 9v6h4l5 4V5L8 9zM16 8a5 5 0 0 1 0 8",
  muted: "M4 9v6h4l5 4V5L8 9zM17 9l5 6M22 9l-5 6",
  play: "M8 5v14l11-7z",
  pause: "M7 5h3v14H7zM14 5h3v14h-3z",
  back: "M15 5l-7 7 7 7",
  plus: "M12 5v14M5 12h14",
};

function Icon({ name, size = 24 }: { name: keyof typeof icon; size?: number }) {
  return (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <path d={icon[name]} />
    </svg>
  );
}

export default function ShortsFeed({ initialItems, initialNext, text, uploadHref, homeHref }: Props) {
  const [items, setItems] = useState<ShortCardData[]>(initialItems);
  const [next, setNext] = useState<string | null>(initialNext);
  const [loading, setLoading] = useState(false);
  const [loadFailed, setLoadFailed] = useState(false);
  const [active, setActive] = useState(0);
  const [muted, setMuted] = useState(true);
  const [playing, setPlaying] = useState(false);
  const [progress, setProgress] = useState({ index: -1, current: 0, duration: 0 });
  const [expanded, setExpanded] = useState<number | null>(null);
  const [notice, setNotice] = useState<string | null>(null);

  const scroller = useRef<HTMLDivElement | null>(null);
  const cards = useRef(new Map<number, HTMLElement>());
  const videos = useRef(new Map<number, HTMLVideoElement>());
  const activeRef = useRef(0);
  const userPaused = useRef(false); // the person paused this short: do not restart it by itself
  const noticeTimer = useRef<ReturnType<typeof setTimeout> | null>(null);

  // ---- which card is on screen -------------------------------------------------------------------------------------
  useEffect(() => {
    const root = scroller.current;
    if (!root) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
            const index = Number((entry.target as HTMLElement).dataset.index);
            if (Number.isInteger(index)) {
              activeRef.current = index;
              setActive(index);
            }
          }
        }
      },
      { root, threshold: [0.6] },
    );
    cards.current.forEach((el) => observer.observe(el));
    return () => observer.disconnect();
  }, [items.length]);

  // ---- play only the active video ----------------------------------------------------------------------------------
  const previousActive = useRef(-1);
  useEffect(() => {
    const changed = previousActive.current !== active;
    previousActive.current = active;
    if (changed) userPaused.current = false;
    videos.current.forEach((video, index) => {
      if (index === active) {
        video.muted = muted;
        if (changed) {
          try { video.currentTime = 0; } catch { /* not ready yet: it starts from the beginning anyway */ }
        }
        if (!userPaused.current) video.play().then(() => setPlaying(true)).catch(() => setPlaying(false)); // blocked autoplay: shows the play button
      } else {
        video.pause();
      }
    });
  }, [active, muted, items.length]);

  // ---- load the next page ------------------------------------------------------------------------------------------
  const loadMore = useCallback(async () => {
    if (!next || loading) return;
    setLoading(true);
    setLoadFailed(false);
    try {
      const response = await fetch(`/api/shorts/feed?cursor=${encodeURIComponent(next)}`, { cache: "no-store" });
      if (!response.ok) throw new Error(String(response.status));
      const page = (await response.json()) as { items: ShortCardData[]; next: string | null };
      setItems((old) => {
        const have = new Set(old.map((item) => item.id));
        return [...old, ...page.items.filter((item) => !have.has(item.id))];
      });
      setNext(page.next);
    } catch {
      setLoadFailed(true);
    } finally {
      setLoading(false);
    }
  }, [next, loading]);

  useEffect(() => {
    if (loadFailed || !shouldLoadMore(active, items.length, next !== null, loading, SHORT_PRELOAD_AHEAD)) return;
    // Deferred so loadMore's setState runs in a timer callback, not synchronously in the effect body.
    const timer = setTimeout(() => void loadMore(), 0);
    return () => clearTimeout(timer);
  }, [active, items.length, next, loading, loadFailed, loadMore]);

  // ---- actions -----------------------------------------------------------------------------------------------------
  const goTo = useCallback((index: number) => {
    const el = cards.current.get(index);
    if (!el) return;
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    el.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
  }, []);

  const step = useCallback((direction: 1 | -1) => goTo(stepIndex(activeRef.current, direction, items.length)), [goTo, items.length]);

  const togglePlay = useCallback(() => {
    const video = videos.current.get(activeRef.current);
    if (!video) return;
    if (video.paused) {
      userPaused.current = false;
      void video.play().catch(() => {});
    } else {
      userPaused.current = true;
      video.pause();
    }
  }, []);

  const toggleMute = useCallback(() => setMuted((m) => !m), []);

  const skip = useCallback((delta: number) => {
    const video = videos.current.get(activeRef.current);
    if (!video) return;
    video.currentTime = seekTarget(video.currentTime, delta, video.duration);
  }, []);

  const showNotice = useCallback((message: string) => {
    setNotice(message);
    if (noticeTimer.current) clearTimeout(noticeTimer.current);
    noticeTimer.current = setTimeout(() => setNotice(null), 2200);
  }, []);
  useEffect(() => () => { if (noticeTimer.current) clearTimeout(noticeTimer.current); }, []);

  const share = useCallback(async (short: ShortCardData) => {
    const url = `${window.location.origin}/shorts/${short.id}`;
    try {
      if (typeof navigator.share === "function") {
        await navigator.share({ title: short.title, url });
        return;
      }
    } catch (error) {
      if ((error as DOMException)?.name === "AbortError") return; // the person closed the share sheet
    }
    try {
      await navigator.clipboard.writeText(url);
      showNotice(text.linkCopied);
    } catch {
      showNotice(text.copyFailed);
    }
  }, [showNotice, text.copyFailed, text.linkCopied]);

  // ---- keyboard ----------------------------------------------------------------------------------------------------
  useEffect(() => {
    function onKey(event: KeyboardEvent) {
      if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      const tag = target?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || target?.isContentEditable) return;
      const onButton = tag === "BUTTON" || tag === "A";
      switch (event.key) {
        case "ArrowDown": event.preventDefault(); step(1); break;
        case "ArrowUp": event.preventDefault(); step(-1); break;
        case "ArrowRight": event.preventDefault(); skip(SHORT_SKIP_SECONDS); break;
        case "ArrowLeft": event.preventDefault(); skip(-SHORT_SKIP_SECONDS); break;
        case " ": if (!onButton) { event.preventDefault(); togglePlay(); } break;
        case "m": case "M": event.preventDefault(); toggleMute(); break;
        default: break;
      }
    }
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [step, skip, togglePlay, toggleMute]);

  // ---- page chrome: no page scroll behind the player ---------------------------------------------------------------
  useEffect(() => {
    const previous = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    return () => { document.body.style.overflow = previous; };
  }, []);

  // ---- render ------------------------------------------------------------------------------------------------------
  return (
    <div className="shorts-stage" role="region" aria-label={text.pageTitle}>
      <div className="shorts-top">
        <Link href={homeHref} className="shorts-chip" aria-label={text.back}><Icon name="back" size={20} /></Link>
        <span className="shorts-title">{text.pageTitle}</span>
        <Link href={uploadHref} className="shorts-chip" aria-label={text.upload}><Icon name="plus" size={20} /></Link>
      </div>

      <div className="shorts-nav">
        <button type="button" className="shorts-round" onClick={() => step(-1)} disabled={active <= 0} aria-label={text.previous}><Icon name="up" /></button>
        <button type="button" className="shorts-round" onClick={() => step(1)} disabled={active >= items.length - 1} aria-label={text.next}><Icon name="down" /></button>
      </div>

      <div className="shorts-scroller" ref={scroller} tabIndex={-1}>
        {items.length === 0 ? (
          <section className="shorts-card"><div className="shorts-frame shorts-empty">
            <p>{text.empty}</p>
            <Link href={uploadHref} className="shorts-follow">{text.emptyUpload}</Link>
          </div></section>
        ) : (
          items.map((short, index) => {
            const near = Math.abs(index - active) <= 1;
            const isActive = index === active;
            const name = short.displayName || short.username;
            const fit = fitMode(short.width, short.height, SHORT_COVER_MIN_RATIO, SHORT_COVER_MAX_RATIO);
            const open = expanded === short.id;
            const shownProgress = progress.index === index ? progress : { index, current: 0, duration: 0 };
            return (
              <section
                key={short.id}
                className="shorts-card"
                data-index={index}
                ref={(el) => { if (el) cards.current.set(index, el); else cards.current.delete(index); }}
                aria-label={fill(text.videoLabel, { name, title: short.title })}
              >
                <div className="shorts-frame">
                  {near ? (
                    <video
                      className={`shorts-video shorts-${fit}`}
                      ref={(el) => { if (el) videos.current.set(index, el); else videos.current.delete(index); }}
                      src={short.videoUrl}
                      poster={short.thumbUrl}
                      playsInline
                      loop
                      muted={isActive ? muted : true}
                      preload={isActive ? "auto" : "metadata"}
                      onClick={isActive ? togglePlay : undefined}
                      onPlay={() => { if (activeRef.current === index) setPlaying(true); }}
                      onPause={() => { if (activeRef.current === index) setPlaying(false); }}
                      onTimeUpdate={(e) => {
                        if (activeRef.current === index) setProgress({ index, current: e.currentTarget.currentTime, duration: e.currentTarget.duration });
                      }}
                      onLoadedMetadata={(e) => {
                        if (activeRef.current === index) setProgress({ index, current: e.currentTarget.currentTime, duration: e.currentTarget.duration });
                      }}
                    />
                  ) : (
                    // eslint-disable-next-line @next/next/no-img-element
                    <img className={`shorts-video shorts-${fit}`} src={short.thumbUrl} alt="" loading="lazy" />
                  )}

                  {isActive && !playing && (
                    <button type="button" className="shorts-bigplay" onClick={togglePlay} aria-label={text.play}><Icon name="play" size={44} /></button>
                  )}

                  <div className="shorts-side">
                    <button type="button" className="shorts-act" disabled title={text.soon} aria-label={`${text.like} (${text.soon})`}><Icon name="heart" size={28} /><span>{text.like}</span></button>
                    <button type="button" className="shorts-act" disabled title={text.soon} aria-label={`${text.comment} (${text.soon})`}><Icon name="comment" size={28} /><span>{text.comment}</span></button>
                    <button type="button" className="shorts-act" onClick={() => void share(short)} aria-label={text.share}><Icon name="share" size={28} /><span>{text.share}</span></button>
                    <button type="button" className="shorts-act" disabled title={text.soon} aria-label={`${text.save} (${text.soon})`}><Icon name="save" size={28} /><span>{text.save}</span></button>
                  </div>

                  <div className="shorts-bottom">
                    <div className="shorts-controls">
                      <button type="button" className="shorts-mini" onClick={() => skip(-SHORT_SKIP_SECONDS)} aria-label={text.back10} disabled={!isActive}>−{SHORT_SKIP_SECONDS}</button>
                      <button type="button" className="shorts-mini" onClick={togglePlay} aria-label={playing && isActive ? text.pause : text.play} disabled={!isActive}><Icon name={playing && isActive ? "pause" : "play"} size={18} /></button>
                      <button type="button" className="shorts-mini" onClick={() => skip(SHORT_SKIP_SECONDS)} aria-label={text.forward10} disabled={!isActive}>+{SHORT_SKIP_SECONDS}</button>
                      <button type="button" className="shorts-mini" onClick={toggleMute} aria-label={muted ? text.unmute : text.mute} disabled={!isActive}><Icon name={muted ? "muted" : "volume"} size={18} /></button>
                      <span className="shorts-clock">{formatClock(shownProgress.current)} / {formatClock(shownProgress.duration)}</span>
                    </div>

                    <div className="shorts-creator">
                      <Link href={`/social/u/${short.username}`} className="shorts-name">{fill(text.by, { name })}</Link>
                    </div>
                    {short.title && <p className="shorts-caption-title">{short.title}</p>}
                    {short.description && (
                      <p className={`shorts-caption${open ? " is-open" : ""}`}>
                        {short.description}
                        {short.description.length > 90 && (
                          <button type="button" className="shorts-more" onClick={() => setExpanded(open ? null : short.id)}>{open ? text.less : text.more}</button>
                        )}
                      </p>
                    )}

                    <input
                      className="shorts-seek"
                      type="range"
                      min={0}
                      max={1000}
                      value={progressPermille(shownProgress.current, shownProgress.duration)}
                      disabled={!isActive}
                      aria-label={text.seek}
                      onChange={(e) => {
                        const video = videos.current.get(index);
                        if (video && Number.isFinite(video.duration)) video.currentTime = (Number(e.target.value) / 1000) * video.duration;
                      }}
                    />
                  </div>
                </div>
              </section>
            );
          })
        )}

        {items.length > 0 && (
          <section className="shorts-card" aria-live="polite">
            <div className="shorts-frame shorts-empty">
              {loading ? <p>{text.loadingMore}</p> : loadFailed ? (
                <>
                  <p>{text.loadError}</p>
                  <button type="button" className="shorts-follow" onClick={() => { setLoadFailed(false); void loadMore(); }}>{text.retry}</button>
                </>
              ) : next ? <p>{text.loadingMore}</p> : <p>{text.end}</p>}
            </div>
          </section>
        )}
      </div>

      {notice && <div className="shorts-toast" role="status">{notice}</div>}
    </div>
  );
}
