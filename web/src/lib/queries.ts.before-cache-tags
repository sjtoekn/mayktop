// Reposts that may be shown in a feed: the person who reposted AND the original post both follow the same rules as any
// Social post (visible, not deleted, account shown), so a repost disappears with its original and comes back with it.
const socialRepostWhere = {
  user: socialAuthorShown,
  socialPost: socialFeedWhere,
} satisfies Prisma.SocialRepostWhereInput;

const socialRepostSelect = {
  id: true,
  quoteText: true,
  createdAt: true,
  user: { select: { username: true, displayName: true } },
  socialPost: { select: socialPostSelect },
} satisfies Prisma.SocialRepostSelect;

