  if (names.length === 0) return [];

  try {
    const rows = await prisma.follow.findMany({
      where: { followerId: userId, following: { username: { in: names } } },
      select: { following: { select: { username: true } } },
    });
    return rows.map((row) => row.following.username);
  } catch (error) {
    console.error("getMyFollowing failed:", error);
    return [];
  }
