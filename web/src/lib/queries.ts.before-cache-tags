/**
 * Accounts that may be shown (socialAuthorShown) whose username or display name contains `term` (lower case, no @).
 * Best match first (exact, starts with, rest; then by username), at most SOCIAL_SEARCH_LIST_SIZE. `blocked` = the people
 * the viewer blocked or who blocked the viewer: they never appear (a muted person still does).
 */
export async function searchSocialPeople(term: string, blocked: ReadonlySet<string>): Promise<SocialPerson[]> {
  const select = { username: true, displayName: true } as const;
  const [starts, contains] = await Promise.all([
    prisma.user.findMany({
      where: { AND: [socialAuthorShown, { username: { startsWith: term } }] },
      orderBy: { username: "asc" },
      take: 60,
      select,
    }),
    prisma.user.findMany({
      where: { AND: [socialAuthorShown, { OR: [{ username: { contains: term } }, { displayName: { contains: term } }] }] },
      orderBy: { username: "asc" },
      take: 120,
      select,
    }),
  ]);
  const visible = [...starts, ...contains].filter((person) => !blocked.has(person.username));
  return rankPeople(visible, term);
}

/**
 * Hashtags (saved form, no `#`) that contain `term` and are used by at least one Social post that may be shown. The exact
 * hashtag first, then the most recently used first (NOT the most used: the fair-ranking rule). No post counts are shown,
 * because a count would include posts of blocked people.
 */
export async function searchSocialTags(term: string): Promise<string[]> {
  const shown = { socialPost: socialFeedWhere };
  const [exact, rows] = await Promise.all([
    prisma.socialPostTag.findFirst({ where: { tag: term, ...shown }, select: { tag: true } }),
    prisma.socialPostTag.groupBy({
      by: ["tag"],
      where: { tag: { contains: term }, ...shown },
      _max: { createdAt: true },
      orderBy: { _max: { createdAt: "desc" } },
      take: SOCIAL_SEARCH_LIST_SIZE,
    }),
  ]);
  return rankTags([...(exact ? [exact.tag] : []), ...rows.map((row) => row.tag)], term);
}

// ---- "n new posts" banner (SOCIAL_TODO B4, patch-social-newposts). How many Social posts and reposts are NEWER than
// `sinceMs`, with the same visibility rules as the feeds. NOT the viewer's own items; not the people in `hidden` (Block
// and Mute: usernames, see loadHiddenAuthors); on "following" only the people the viewer follows. At most NEW_POSTS_CAP are
// counted. Not cached: it belongs to one viewer and the shared caches hold no personal data. Logged-in people only.
export async function countNewSocialItems(
  viewerId: string,
  kind: "all" | "following",
  sinceMs: number,
  hidden: ReadonlySet<string>,
): Promise<number> {
  const since = new Date(sinceMs);
  const hiddenNames = [...hidden];

  let authors: { in: string[] } | { not: string }; // fits both `authorId` (posts) and `userId` (reposts)
  if (kind === "following") {
    const followed = await prisma.follow.findMany({ where: { followerId: viewerId }, select: { followingId: true }, take: MAX_FOLLOWING_IDS });
    // the viewer's own items never count, so the viewer is taken out of the list that `followingAuthorIds` builds
    authors = { in: followingAuthorIds(viewerId, followed.map((row) => row.followingId)).filter((id) => id !== viewerId) };
  } else {
    authors = { not: viewerId };
  }

  const [posts, reposts] = await Promise.all([
    prisma.socialPost.count({
      where: {
        AND: [
          socialFeedWhere,
          { createdAt: { gt: since } },
          { authorId: authors },
          { author: { username: { notIn: hiddenNames } } },
        ],
      },
      take: NEW_POSTS_CAP,
    }),
    prisma.socialRepost.count({
      where: {
        AND: [
          socialRepostWhere,
          { createdAt: { gt: since } },
          { userId: authors },
          { user: { username: { notIn: hiddenNames } } },
          { socialPost: { author: { username: { notIn: hiddenNames } } } },
        ],
      },
      take: NEW_POSTS_CAP,
    }),
  ]);
  return Math.min(posts + reposts, NEW_POSTS_CAP);
}

/**
 * The Bookmarks page (/social/bookmarks, SOCIAL_TODO B2): the Social posts THIS person saved, the most recently SAVED first.
 * Same visibility rules as every feed (`socialFeedWhere`: visible, not deleted, author's account shown), so a hidden or deleted
 * post drops out of the list and comes back with the post. NOT cached on purpose: the list is private and belongs to one viewer.
 * `before` is the cursor of social-bookmark-rules.ts. The page applies Block afterwards (the same as the feeds).
 */
export async function getSocialBookmarks(
  viewerId: string,
  before: string | null = null,
): Promise<{ items: SocialFeedItem[]; next: string | null }> {
  const cursor = parseBookmarkCursor(before);
  const rows = await prisma.socialPostBookmark.findMany({
    where: { AND: [{ userId: viewerId, socialPost: socialFeedWhere }, bookmarkAfterWhere(cursor)] },
    orderBy: [{ createdAt: "desc" }, { socialPostId: "desc" }],
    take: SOCIAL_FEED_SIZE + 1,
    select: { createdAt: true, socialPostId: true, socialPost: { select: socialPostSelect } },
  });
  const keyed = rows.map((row) => ({ row, savedAtMs: row.createdAt.getTime(), id: row.socialPostId }));
  const { items, next } = cutBookmarkPage(keyed, SOCIAL_FEED_SIZE);
  return {
    items: items.map(({ row, savedAtMs }): SocialFeedItem => ({ kind: "post", createdAtMs: savedAtMs, post: toSocialSummary(row.socialPost) })),
    next: next ? bookmarkCursorToText(next) : null,
  };
}
