    orderBy: [{ createdAt: "desc" }, { id: "desc" }],
    take: SOCIAL_FEED_SIZE,
    select: socialRepostSelect,
  });
  return rows.map(toRepostItem);
}

/**
 * One Social post for its own page (/social/<id>, SOCIAL_TODO 14), or null when it does not exist or may not be shown
 * (hidden, removed, deleted, or written by an account whose posts are not shown: the same `socialFeedWhere` as the feeds).
 * ONLY for logged-in people (PROJECT.md 8j point 11): the page must not call this for a visitor.
 * Cached like the feed (tag "social-posts"); the person's own like is loaded separately (getMySocialLikes).
 */
export async function getSocialPost(id: number): Promise<SocialPostSummary | null> {
  "use cache";
  cacheLife("minutes");
  cacheTag("social-posts");

  const row = await prisma.socialPost.findFirst({
    where: { ...socialFeedWhere, id },
    select: socialPostSelect,
  });
  return row ? toSocialSummary(row) : null;
}

/**
 * Home: combine the newest Community and Social posts without mixing their data models.
 * Community posts are open to everybody. Social posts are only for people who are logged in
 * (PROJECT.md 8j point 11), so the page passes `includeSocial` = whether somebody is logged in; without it
 * the Social posts are not even read from the database. The two answers are cached separately, and neither
 * holds anything personal.
 */
export async function getHomeFeed(includeSocial: boolean): Promise<HomeFeedItem[]> {
  "use cache";
  cacheLife("minutes");
  cacheTag("posts", "social-posts");

  const [communityPosts, socialRows, repostRows] = await Promise.all([
    loadPosts({}, 50),
    includeSocial
      ? prisma.socialPost.findMany({
          where: socialFeedWhere,
          orderBy: [{ createdAt: "desc" }, { id: "desc" }],
          take: SOCIAL_FEED_SIZE,
          select: socialPostSelect,
        })
      : Promise.resolve<SocialRow[]>([]),
    includeSocial
      ? prisma.socialRepost.findMany({
          where: socialRepostWhere,
          orderBy: [{ createdAt: "desc" }, { id: "desc" }],
          take: SOCIAL_FEED_SIZE,
          select: socialRepostSelect,
        })
      : Promise.resolve<SocialRepostRow[]>([]),
  ]);

  const communityItems: HomeFeedItem[] = communityPosts.map((post) => ({
    kind: "community",
    createdAtMs: post.createdAtMs,
    post,
  }));

  const socialItems: HomeFeedItem[] = socialRows.map((row) => ({
    kind: "social",
    createdAtMs: row.createdAt.getTime(),
    post: toSocialSummary(row),
  }));

  const repostItems: HomeFeedItem[] = repostRows.map(toRepostItem);

  // At the same moment: a Social post, then a repost, then a Community post; then the higher id first.
  const kindRank = { social: 0, repost: 1, community: 2 } as const;
  const idOf = (item: HomeFeedItem) => (item.kind === "repost" ? item.repostId : item.post.id);

  const merged = [...communityItems, ...socialItems, ...repostItems]
    .sort((a, b) => {
      const difference = b.createdAtMs - a.createdAtMs;
      if (difference !== 0) return difference;
      if (a.kind !== b.kind) return kindRank[a.kind] - kindRank[b.kind];
      return idOf(b) - idOf(a);
    })
    .slice(0, 50);
  return collapsePlainReposts(merged); // SOCIAL_TODO B10
}

/**
 * The Following feed (/social/following, SOCIAL_TODO 17): Social posts AND reposts / quotes by the people THIS person
 * follows and by the person themselves, newest first (never by popularity). Same visibility rules as the other feeds
 * (`socialFeedWhere`, `socialRepostWhere`: visible, not deleted, accounts shown).
 * ONLY for logged-in people (PROJECT.md 8j point 11). NOT cached on purpose: the answer belongs to one viewer, and the
 * shared caches must hold no personal data. `following` is how many people the viewer follows (the page uses it to say
 * "you follow nobody yet" instead of "nothing here").
 */
export async function getFollowingFeed(
  viewerId: string,
  before: string | null = null,
): Promise<{ following: number; items: SocialFeedItem[]; next: string | null }> {
  const cursor = parseCursor(before);
  const followed = await prisma.follow.findMany({
    where: { followerId: viewerId },
    select: { followingId: true },
    take: MAX_FOLLOWING_IDS,
  });
  const authorIds = followingAuthorIds(viewerId, followed.map((row) => row.followingId));

  const [rows, repostRows] = await Promise.all([
    prisma.socialPost.findMany({
      where: { AND: [socialFeedWhere, { authorId: { in: authorIds } }, afterCursorWhere(cursor, 0)] },
      orderBy: [{ createdAt: "desc" }, { id: "desc" }],
      take: SOCIAL_FEED_SIZE + 1,
      select: socialPostSelect,
    }),
    prisma.socialRepost.findMany({
      where: { AND: [socialRepostWhere, { userId: { in: authorIds } }, afterCursorWhere(cursor, 1)] },
      orderBy: [{ createdAt: "desc" }, { id: "desc" }],
      take: SOCIAL_FEED_SIZE + 1,
      select: socialRepostSelect,
    }),
  ]);

  const items: SocialFeedItem[] = [
    ...rows.map((row): SocialFeedItem => ({ kind: "post", createdAtMs: row.createdAt.getTime(), post: toSocialSummary(row) })),
    ...repostRows.map(toRepostItem),
  ];
  return { following: followed.length, ...toFeedPage(items) };
}

const MAX_SOCIAL_LIKE_IDS = 200; // a page never shows more Social posts than this

/**
 * Which of these Social posts has THIS person liked? (SOCIAL_TODO 9)
 * Not cached on purpose: the answer belongs to one viewer, and the shared caches
 * (getHomeFeed and the others) must hold no personal data (see the note at the top of this file).
 * Only call it from a page that already runs per request (the Home page calls `connection()`).
 * Nobody logged in, or no posts: the answer is an empty list and the database is not asked.
 * If the database fails, the page still opens (hearts show as not liked) and the error is logged,
 * the same as getMyVotes.
 */
export async function getMySocialLikes(
  userId: string | null | undefined,
  socialPostIds: number[],
): Promise<number[]> {
  if (!userId) return [];
  const ids = [...new Set(socialPostIds.filter((id) => Number.isInteger(id) && id >= 1))].slice(
    0,
    MAX_SOCIAL_LIKE_IDS,
  );
  if (ids.length === 0) return [];

  try {
    const rows = await prisma.socialPostLike.findMany({
      where: { userId, socialPostId: { in: ids } },
      select: { socialPostId: true },
    });
    return rows.map((row) => row.socialPostId);
  } catch (error) {
    console.error("getMySocialLikes failed:", error);
    return [];
  }
}

/**
 * Which of these Social posts has THIS person reposted (plain or quote)? (SOCIAL_TODO 16)
 * Same rules as getMySocialLikes: not cached (the answer belongs to one viewer), nobody logged in or no posts = an
 * empty answer without asking the database, and a database error is logged while the page still opens (every
 * button shows "not reposted").
 */
export async function getMySocialReposts(
  userId: string | null | undefined,
  socialPostIds: number[],
): Promise<number[]> {
  if (!userId) return [];
  const ids = [...new Set(socialPostIds.filter((id) => Number.isInteger(id) && id >= 1))].slice(
    0,
    MAX_SOCIAL_LIKE_IDS,
  );
  if (ids.length === 0) return [];

  try {
    const rows = await prisma.socialRepost.findMany({
      where: { userId, socialPostId: { in: ids } },
      select: { socialPostId: true },
    });
    return rows.map((row) => row.socialPostId);
  } catch (error) {
    console.error("getMySocialReposts failed:", error);
    return [];
  }
}

