export async function getMyFollowing(
  userId: string | null | undefined,
  usernames: string[],
): Promise<string[]> {
  if (!userId) return [];
  const names = [...new Set(usernames.filter((name) => typeof name === "string" && name.length > 0))].slice(
    0,
    MAX_FOLLOW_NAMES,
