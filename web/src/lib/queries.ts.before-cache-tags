export type ModActionKind = "hidden" | "restored" | "removed" | "appealUpheld" | "appealDenied";

export type ModLogItem = {
  id: number;
  time: string;
  moderator: string; // username
  action: ModActionKind;
  target: "post" | "comment";
  community: string; // slug
  subject: string; // "by maya_r" while the content still exists, otherwise empty
  rule: string; // "Rule 2: Be respectful to others", empty when no rule was recorded
  reason: string;
  postId?: number; // set only when the post can still be opened (adds a link)
};

// Only these audit-log actions are public. Other actions (roles, suspensions ...) are not listed here.
const modActionKinds: Record<string, ModActionKind> = {
  [AuditAction.CONTENT_HIDDEN]: "hidden",
  [AuditAction.CONTENT_RESTORED]: "restored",
  [AuditAction.CONTENT_REMOVED]: "removed",
  [AuditAction.APPEAL_ACCEPTED]: "appealUpheld",
  [AuditAction.APPEAL_REJECTED]: "appealDenied",
};

// Audit rows keep the target id as text. Only plain whole numbers can point to a post or comment.
function numericIds(ids: string[]): number[] {
  return ids.filter((id) => /^\d{1,9}$/.test(id)).map(Number);
}

/** The 100 newest moderator actions on posts and comments, newest first. */
export async function getModLog(): Promise<ModLogItem[]> {
  "use cache";
  cacheLife("minutes");
  cacheTag("modlog");

  const rows = await prisma.auditLog.findMany({
    where: {
      action: { in: Object.keys(modActionKinds) as AuditAction[] },
      targetType: { in: [AuditTarget.POST, AuditTarget.COMMENT] },
      communityId: { not: null },
    },
    orderBy: [{ createdAt: "desc" }, { id: "desc" }],
    take: 100,
    select: {
      id: true,
      createdAt: true,
      action: true,
      targetType: true,
      targetId: true,
      reason: true,
      actor: { select: { username: true } },
      community: { select: { slug: true } },
      rule: { select: { position: true, title: true } },
    },
  });

  const postIds = numericIds(rows.filter((r) => r.targetType === AuditTarget.POST).map((r) => r.targetId));
  const commentIds = numericIds(rows.filter((r) => r.targetType === AuditTarget.COMMENT).map((r) => r.targetId));
  const [posts, comments] = await Promise.all([
    prisma.post.findMany({
      where: { id: { in: postIds } },
      select: { id: true, status: true, author: { select: { username: true, status: true } } },
    }),
    prisma.comment.findMany({
      where: { id: { in: commentIds } },
      select: {
        id: true,
        postId: true,
        author: { select: { username: true, status: true } },
        post: { select: { status: true } },
      },
    }),
  ]);
  const postById = new Map(posts.map((p) => [p.id, p]));
  const commentById = new Map(comments.map((c) => [c.id, c]));

  return rows.map((r) => {
    const isPost = r.targetType === AuditTarget.POST;
    const numeric = numericIds([r.targetId])[0];
    const post = isPost && numeric !== undefined ? postById.get(numeric) : undefined;
    const comment = !isPost && numeric !== undefined ? commentById.get(numeric) : undefined;
    // An erased person's name is never shown (PROJECT.md 8c point 6): the rule and the reason stay, the name does not.
    const writer = post?.author ?? comment?.author;
    const author = writer && writer.status !== UserStatus.DELETED ? writer.username : undefined;
    // A removed post still opens: the page shows the notice with the rule and the reason (TODO 39).
    const openableId = post ? post.id : comment ? comment.postId : undefined;
    return {
      id: r.id,
      time: timeAgo(r.createdAt),
      moderator: r.actor.username,
      action: modActionKinds[r.action],
      target: isPost ? "post" : "comment",
      community: r.community?.slug ?? "",
      subject: author ? t("post.by", { author }) : "",
      rule: ruleLabel(r.rule),
      reason: r.reason ?? "",
      ...(openableId !== undefined ? { postId: openableId } : {}),
    };
  });
}

