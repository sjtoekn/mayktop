export async function getSocialTrendingTags(): Promise<TrendingTag[]> {
  "use cache";
  cacheLife("minutes");
  cacheTag("social-posts");

  const config = socialLimits.discover;
  const since = new Date(nowMs() - config.trendingWindowHours * 3_600_000);
  const rows = await prisma.socialPostTag.findMany({
    where: { socialPost: { status: ContentStatus.VISIBLE, deletedAt: null, createdAt: { gte: since }, author: { status: UserStatus.ACTIVE, deletedAt: null } } },
    orderBy: { createdAt: "desc" },
    take: config.trendingScanLimit,
    select: { tag: true, socialPost: { select: { authorId: true, createdAt: true } } },
  });
  return rankTrendingTags(
    rows.map((row) => ({ tag: row.tag, authorId: row.socialPost.authorId, createdAtMs: row.socialPost.createdAt.getTime() })),
