  edited?: true; // the author changed the text after posting
  replies?: CommentNode[];
};

/** A date as "12 minutes ago" / "yesterday" in the active language. Older than 30 days: a date. */
export function timeAgo(date: Date): string {
  const locale = getLocale();
  const rtf = new Intl.RelativeTimeFormat(locale, { numeric: "auto" });
  const seconds = Math.round((Date.now() - date.getTime()) / 1000);
  if (seconds < 60) return rtf.format(0, "second");
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return rtf.format(-minutes, "minute");
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return rtf.format(-hours, "hour");
  const days = Math.floor(hours / 24);
  if (days < 30) return rtf.format(-days, "day");
  return new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeZone: "UTC" }).format(date);
}

function ruleLabel(rule: { position: number; title: string } | null): string {
  return rule ? `Rule ${rule.position}: ${rule.title}` : "";
}

const postSelect = {
  id: true,
  title: true,
  body: true,
  status: true,
  statusNote: true,
  createdAt: true,
  editedAt: true,
  deletedAt: true,
  community: { select: { slug: true } },
  author: { select: { username: true } },
  statusRule: { select: { position: true, title: true } },
  _count: { select: { comments: { where: { status: { not: ContentStatus.REMOVED } } } } },
} satisfies Prisma.PostSelect;

type PostRow = Prisma.PostGetPayload<{ select: typeof postSelect }>;

const commentSelect = {
  id: true,
  parentId: true,
  body: true,
  status: true,
  statusNote: true,
  createdAt: true,
  editedAt: true,
  deletedAt: true,
  author: { select: { username: true } },
  statusRule: { select: { position: true, title: true } },
} satisfies Prisma.CommentSelect;

type CommentRow = Prisma.CommentGetPayload<{ select: typeof commentSelect }>;

type VoteInfo = { votes: number };

/** Vote total (up minus down) for each post id. */
async function postVoteInfo(ids: number[]): Promise<Map<number, VoteInfo>> {
  if (ids.length === 0) return new Map();
  const sums = await prisma.postVote.groupBy({
    by: ["postId"],
    where: { postId: { in: ids } },
    _sum: { value: true },
  });
  return new Map(ids.map((id) => [id, { votes: sums.find((s) => s.postId === id)?._sum.value ?? 0 }]));
}

/** Vote total (up minus down) for each comment of one post. */
async function commentVoteInfo(postId: number): Promise<Map<number, VoteInfo>> {
  const sums = await prisma.commentVote.groupBy({
    by: ["commentId"],
    where: { comment: { postId } },
    _sum: { value: true },
  });
  return new Map(sums.map((s) => [s.commentId, { votes: s._sum.value ?? 0 }]));
}

// Hidden and erased content is blanked here, so its text never reaches a page. An erased
// (deleted) item also loses its author name: nobody can see who wrote it any more.
function toPost(row: PostRow, vote: VoteInfo | undefined): PostSummary {
  const deleted = row.deletedAt !== null;
  const removed = !deleted && row.status === ContentStatus.REMOVED;
  const hidden = !deleted && (removed || row.status === ContentStatus.HIDDEN_PENDING_REVIEW);
  const blank = deleted || hidden;
  return {
    id: row.id,
    createdAtMs: row.createdAt.getTime(),
    community: row.community.slug,
    author: deleted ? "" : row.author.username,
    time: timeAgo(row.createdAt),
    title: blank ? "" : row.title,
    body: blank ? "" : row.body,
    votes: vote?.votes ?? 0,
    comments: row._count.comments,
    ...(deleted ? { deleted: true as const } : {}),
    ...(row.editedAt !== null && !blank ? { edited: true as const } : {}),
    ...(hidden ? { hidden: { rule: ruleLabel(row.statusRule), note: row.statusNote ?? "", ...(removed ? { removed: true as const } : {}) } } : {}),
  };
}

function toComment(row: CommentRow, vote: VoteInfo | undefined): CommentNode {
  const deleted = row.deletedAt !== null;
  const removed = !deleted && row.status === ContentStatus.REMOVED;
  const hidden = !deleted && (removed || row.status === ContentStatus.HIDDEN_PENDING_REVIEW);
  const blank = deleted || hidden;
  return {
    id: row.id,
    author: deleted ? "" : row.author.username,
    time: timeAgo(row.createdAt),
    text: blank ? "" : row.body,
    votes: vote?.votes ?? 0,
    ...(deleted ? { deleted: true as const } : {}),
    ...(row.editedAt !== null && !blank ? { edited: true as const } : {}),
    ...(hidden ? { hidden: { rule: ruleLabel(row.statusRule), note: row.statusNote ?? "", ...(removed ? { removed: true as const } : {}) } } : {}),
  };
}

async function loadPosts(where: Prisma.PostWhereInput, take?: number): Promise<PostSummary[]> {
  const rows = await prisma.post.findMany({
    // Erased posts are not listed anywhere; only their own /post/<id> page shows the notice.
    where: { status: { not: ContentStatus.REMOVED }, deletedAt: null, ...where },
    orderBy: [{ createdAt: "desc" }, { id: "desc" }], // newest first
    ...(take ? { take } : {}),
    select: postSelect,
  });
  const info = await postVoteInfo(rows.map((r) => r.id));
  return rows.map((r) => toPost(r, info.get(r.id)));
}

/** Home: every post that is not removed (hidden ones show a notice), newest first. */
export async function getPosts(): Promise<PostSummary[]> {
  "use cache";
  cacheLife("minutes");
  cacheTag("posts");
  return loadPosts({});
}


