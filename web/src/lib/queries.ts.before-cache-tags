/**
 * Popular (TODO 37): no hidden posts; ordered by the fair ranking in src/lib/ranking.ts (votes with
 * diminishing returns and age, one account cannot fill the page, a fixed share of places for new voices).
 * Every visible post is in the list; ranking only changes the order. Cached for a few minutes like the other lists.
 */
export async function getPopularPosts(): Promise<PostSummary[]> {
  "use cache";
  cacheLife("minutes");
  cacheTag("posts");
  const rows = await prisma.post.findMany({
    where: { status: ContentStatus.VISIBLE, deletedAt: null },
    orderBy: [{ createdAt: "desc" }, { id: "desc" }],
    select: rankSelect,
  });
  const info = await postVoteInfo(rows.map((r) => r.id));

  const items: RankItem[] = rows.map((r) => ({
    id: r.id,
    authorKey: r.authorId,
    createdAtMs: r.createdAt.getTime(),
    votes: info.get(r.id)?.votes ?? 0,
    authorCreatedAtMs: r.author.createdAt.getTime(),
    authorPosts: r.author._count.posts,
  }));
  const { ids: order, rising } = rankPopularDetailed(items, Date.now(), rankingConfig);

  const byId = new Map(
    rows.map((r) => [r.id, { ...toPost(r, info.get(r.id)), ...(rising.has(r.id) ? { newVoice: true as const } : {}) }]),
  );
  return order.flatMap((id) => {
    const post = byId.get(id);
    return post ? [post] : [];
  });
}

