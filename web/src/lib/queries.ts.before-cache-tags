export type CommunitySummary = {
  slug: string;
  name: string;
  description: string;
  members: number; // real number of memberships
  rules: { title: string; text: string }[]; // only the active rules, in order
};

/** Every community that is not archived, oldest first. */
export async function getCommunities(): Promise<CommunitySummary[]> {
  "use cache";
  cacheLife("minutes");
  cacheTag("communities");

  const rows = await prisma.community.findMany({
    where: { archivedAt: null },
    orderBy: { id: "asc" },
    include: {
      rules: {
        where: { archivedAt: null },
        orderBy: { position: "asc" },
        select: { title: true, text: true },
      },
      _count: { select: { memberships: true } },
    },
  });

  return rows.map((c) => ({
    slug: c.slug,
    name: c.name,
    description: c.description,
    members: c._count.memberships,
    rules: c.rules,
  }));
}

export async function getCommunity(slug: string): Promise<CommunitySummary | undefined> {
  const all = await getCommunities(); // already cached: no extra database read
  return all.find((c) => c.slug === slug);
}

