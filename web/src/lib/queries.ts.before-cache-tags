/** Set when a post or comment is hidden for review (it is never deleted). */
// removed: true = a second person confirmed the removal (TODO 38/39); the text is still blank, the rule and the reason stay visible.
export type HiddenInfo = { rule: string; note: string; removed?: true };

export type PostSummary = {
  id: number;
  createdAtMs: number;
  community: string; // community slug
  author: string; // username
  time: string; // "12 minutes ago" in the active language
  title: string; // empty while the post is hidden
  body: string; // empty while the post is hidden
  votes: number; // up minus down
  comments: number;
  hidden?: HiddenInfo;
  deleted?: true; // the author erased it: text blank, author hidden (only the post page shows this)
  edited?: true; // the author changed the text after posting
