/**
 * The comment thread under one post: top-level comments, each with its replies (any depth),
 * oldest first. Hidden and removed comments stay in the thread as a notice with the rule and the reason
 * (their text is blank, their replies stay under them).
 */
export async function getComments(postId: number): Promise<CommentNode[]> {
  "use cache";
  cacheLife("minutes");
  cacheTag("comments");
  const rows = await prisma.comment.findMany({
    where: { postId },
    orderBy: [{ createdAt: "asc" }, { id: "asc" }],
    select: commentSelect,
  });
  const info = await commentVoteInfo(postId);

  const nodes = new Map<number, CommentNode>();
  for (const r of rows) nodes.set(r.id, toComment(r, info.get(r.id)));

  const roots: CommentNode[] = [];
  for (const r of rows) {
    const node = nodes.get(r.id)!;
    const parent = r.parentId === null ? undefined : nodes.get(r.parentId);
    if (parent) (parent.replies ??= []).push(node);
    else roots.push(node);
  }
  return roots;
}

/**
 * Search (Phase 1: plain text match). Order is newest first, NOT popularity (fairness
 * principle). Hidden posts are left out, the same as on the Popular page.
 * Not cached on purpose (see the note at the top of this file).
 */
export async function searchContent(
  query: string,
): Promise<{ communities: CommunitySummary[]; posts: PostSummary[] }> {
  const q = query.trim().toLowerCase();
  if (!q) return { communities: [], posts: [] };
  // Not cached, and "x minutes ago" reads the clock: tell Next.js this runs per request.
  await connection();
  const has = (s: string) => s.toLowerCase().includes(q);

  const all = await getCommunities();
  const rows = await prisma.post.findMany({
    where: {
      status: ContentStatus.VISIBLE,
      deletedAt: null,
      OR: [
        { title: { contains: q } },
        { body: { contains: q } },
        { author: { username: { contains: q } } },
      ],
    },
    orderBy: [{ createdAt: "desc" }, { id: "desc" }],
    select: postSelect,
  });
  const info = await postVoteInfo(rows.map((r) => r.id));

  return {
    communities: all.filter((c) => has(c.name) || has(c.slug) || has(c.description)),
    posts: rows.map((r) => toPost(r, info.get(r.id))),
  };
}

