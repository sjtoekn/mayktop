/** What the browser needs to show one ad. No advertiser data, and the destination link stays on the server. */
// format / imageUrl / videoUrl (Session 3b): imageUrl is the picture of an IMAGE ad, or the poster of a VIDEO ad.
// They are always OUR OWN addresses (/api/ad/media/...).
export type AdPoolItem = {
  id: number;
  title: string;
  body: string;
  host: string;
  format: "TEXT" | "IMAGE" | "VIDEO";
  imageUrl: string | null; videoUrl: string | null;
};

/**
 * The candidate ads for one slot (and one community page, if any): ACTIVE ads inside their dates,
 * either for every page or for exactly this community. Fair rotation: ads with the FEWEST impressions
 * in the last `rotation.windowDays` days come first, with some randomness, and `rotation.poolSize`
 * of them are returned. The visitor's browser then picks one it has not shown lately (AdBox.tsx).
 * Shared by everybody and cached for a short time, so it holds no personal data.
 */
export async function getAdPool(slot: "SIDEBAR" | "FEED" | "SOCIAL_FEED" | "HEADER", communitySlug: string | null): Promise<AdPoolItem[]> {
  "use cache";
  cacheLife("minutes");
  cacheTag("ads");

  const now = new Date();
  const forThisPage: Prisma.AdCampaignWhereInput = communitySlug
    ? { OR: [{ communityId: null }, { community: { slug: communitySlug } }] }
    : { communityId: null };
  const ads = await prisma.adCampaign.findMany({
    where: {
      status: AdStatus.ACTIVE,
      slot,
      AND: [
        { OR: [{ startDate: null }, { startDate: { lte: now } }] },
        { OR: [{ endDate: null }, { endDate: { gte: now } }] },
        forThisPage,
      ],
    },
    select: { id: true, title: true, body: true, destinationUrl: true, format: true, imageUrl: true, videoUrl: true },
  });
  if (ads.length === 0) return [];

  const since = new Date(
    Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() - adsConfig.rotation.windowDays),
  );
  const sums = await prisma.adDailyStat.groupBy({
    by: ["adId"],
    where: { adId: { in: ads.map((a) => a.id) }, date: { gte: since } },
    _sum: { impressions: true },
  });
  const shown = new Map(sums.map((r) => [r.adId, r._sum.impressions ?? 0]));

  const ranked = ads
    .map((ad) => ({ ad, shown: shown.get(ad.id) ?? 0, tie: Math.random() }))
    .sort((a, b) => a.shown - b.shown || a.tie - b.tie);

  // Take the least-shown ads (3x the pool size), shuffle them, keep `poolSize`.
  const size = adsConfig.rotation.poolSize;
  const candidates = ranked.slice(0, size * 3).map((r) => r.ad);
  for (let i = candidates.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [candidates[i], candidates[j]] = [candidates[j], candidates[i]];
  }

  return candidates.slice(0, size).map((ad) => {
    let host = "";
    try {
      host = new URL(ad.destinationUrl).hostname.replace(/^www\./, "");
    } catch {
      /* the submit form only accepts https links; an unreadable one just shows no host */
    }
    return { id: ad.id, title: ad.title, body: ad.body, host, format: ad.format, imageUrl: ad.imageUrl, videoUrl: ad.videoUrl };
  });
}

